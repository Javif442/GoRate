<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:background="@color/app_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_user_permissions"
            app:tint="@color/brand_indigo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Configuración Requerida"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="Para que GoRate funcione correctamente, activa los siguientes permisos obligatorios."
        android:textColor="@color/text_sub"
        android:textSize="14sp" />

    <!-- Item 1: Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/app_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_call" app:tint="@color/brand_indigo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mostrar sobre otras apps" android:textColor="@color/text_main" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obligatorio para ver el radar" android:textColor="@color/brand_indigo" android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cardCheckOverlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="invisible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Item 2: Notifications -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/app_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_popup_reminder" app:tint="@color/brand_indigo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notificaciones" android:textColor="@color/text_main" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obligatorio para evitar cierres" android:textColor="@color/brand_indigo" android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cardCheckNotifications"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="invisible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Item 3: Notification Listener (Uber push notifications) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemNotifListener"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/app_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_dialog_info" app:tint="@color/brand_indigo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detector de Notificaciones Uber" android:textColor="@color/text_main" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detecta ofertas mientras usas Maps o Waze" android:textColor="@color/brand_indigo" android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cardCheckNotifListener"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="invisible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Item 4: Battery -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/app_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_power_off" app:tint="@color/brand_indigo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batería sin restricciones" android:textColor="@color/text_main" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recomendado: Evita pausas" android:textColor="@color/text_sub" android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/cardCheckBattery"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="invisible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_indigo"
        app:cornerRadius="16dp" />

</LinearLayout>
